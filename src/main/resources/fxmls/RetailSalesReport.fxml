<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="1020.0" prefWidth="1980.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gymdb.controller.RetailSalesReportController">

   <children>

      <!-- Background -->
      <ImageView fitHeight="1000.0" fitWidth="1700.0" preserveRatio="true">
         <image>
            <Image url="@../pngs/retailsalesreport.png" />
         </image>
      </ImageView>

      <!-- TOTAL SALES BAR CHART -->
      <BarChart fx:id="totalSalesBarChart" layoutX="562.0" layoutY="278.0" prefHeight="360.0" prefWidth="412.0">

         <xAxis>
            <CategoryAxis label="Product Category" />
         </xAxis>

         <yAxis>
            <NumberAxis label="Total Sales" />
         </yAxis>

      </BarChart>

      <!-- AVERAGE SALES PIE CHART -->
      <PieChart fx:id="avgSalesPieChart" layoutX="1069.0" layoutY="198.0" prefHeight="413.0" prefWidth="380.0" />
      <Button layoutX="112.0" layoutY="188.0" mnemonicParsing="false" onAction="#handleLockerUsage" opacity="0.0" prefHeight="72.0" prefWidth="237.0" />
      <Button layoutX="118.0" layoutY="355.0" mnemonicParsing="false" onAction="#handleMemberActivity" opacity="0.0" prefHeight="72.0" prefWidth="237.0" />
      <Button layoutX="99.0" layoutY="525.0" mnemonicParsing="false" onAction="#handlePerformanceReward" opacity="0.0" prefHeight="72.0" prefWidth="298.0" />
      <Button layoutX="55.0" layoutY="57.0" mnemonicParsing="false" onAction="#handleBack" opacity="0.0" prefHeight="47.0" prefWidth="44.0" />

   </children>
</AnchorPane>
