<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1020.0" prefWidth="1980.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gymdb.controller.UpdateEquipmentController">

   <children>
      <ImageView fitHeight="1000.0" fitWidth="1700.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../pngs/updateequip_bg.png" />
         </image>
      </ImageView>

      <!-- TableView -->
      <TableView fx:id="equipmentTable" layoutX="522.0" layoutY="263.0" prefHeight="443.0" prefWidth="847.0">
         <columns>
            <TableColumn fx:id="colName" prefWidth="150.0" text="Name" />
            <TableColumn fx:id="colDescription" prefWidth="150" text="Description" />
            <TableColumn fx:id="colQuantity" prefWidth="60" text="Quantity" />
            <TableColumn fx:id="colUnitPrice" prefWidth="80" text="Unit Price" />
            <TableColumn fx:id="colVendor" prefWidth="100" text="Vendor" />
            <TableColumn fx:id="colContact" prefWidth="100" text="Contact" />
            <TableColumn fx:id="colPurchaseDate" prefWidth="120" text="Purchase Date" />
            <TableColumn fx:id="colAction" prefWidth="80" text="Update" />
         </columns>
      </TableView>

      <!-- Back button -->
      <Button fx:id="backBtn" layoutX="66.0" layoutY="59.0" mnemonicParsing="false" onAction="#handleBack" opacity="0.0" prefHeight="43.0" prefWidth="33.0" />
   </children>
</AnchorPane>
